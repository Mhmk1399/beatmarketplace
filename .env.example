# Copy to .env.local and supply your own values. No real credentials belong here.
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/beatmarketplace-dev
JWT_SECRET=replace-with-at-least-32-random-characters

# Local development keeps originals outside public/. Existing S3 deployments
# should retain their own storage settings when adopting the preview options.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_DIR=.data/media
MEDIA_UPLOAD_CONCURRENCY=2

# Safe default: authorization-checked application cache.
MEDIA_PREVIEW_DELIVERY=cache
# Optional HTTPS CDN BUCKET ROOT, without credentials/query/fragment.
# Stored keys already include MEDIA_S3_PREFIX. Avoid repeating that prefix here.
MEDIA_PREVIEW_CDN_BASE_URL=

# MEDIA_STORAGE_DRIVER=s3
# MEDIA_S3_PROVIDER=S3
# MEDIA_S3_BUCKET=your-bucket
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=https://your-storage-endpoint.example
# MEDIA_S3_ACCESS_KEY_ID=your-access-key
# MEDIA_S3_SECRET_ACCESS_KEY=your-secret-key
# MEDIA_S3_PREFIX=beatmarket
# MEDIA_S3_FORCE_PATH_STYLE=false
# MEDIA_S3_DELIVERY_MODE=proxy
# FFMPEG_PATH=/absolute/path/to/ffmpeg

# Enable only with real merchant settings; retain sandbox for testing.
ZARINPAL_SANDBOX=true
# ZARINPAL_MERCHANT_ID=your-merchant-uuid
# Base64-encoded 32-byte server key for uploaded sound kits.
# Generate with openssl rand -base64 32 and back it up before accepting orders.
SOUND_KIT_ENCRYPTION_KEY=
