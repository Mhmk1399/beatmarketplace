MONGODB_URI=mongodb://localhost:27017/beatmarketplace-dev
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=beatmarketplace
JWT_AUDIENCE=beatmarketplace-web

# Private media. Local is convenient for development; use shared object storage for replicas.
MEDIA_STORAGE_DRIVER=local
# MEDIA_STORAGE_DIR=D:/beatmarketplace-media
MEDIA_UPLOAD_CONCURRENCY=2

# S3-compatible private bucket (R2, AWS S3, MinIO, Liara, etc.).
# Set MEDIA_STORAGE_DRIVER=s3 to enable. Missing credentials fail closed.
MEDIA_S3_PROVIDER=S3
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PREFIX=media
MEDIA_S3_FORCE_PATH_STYLE=false

# Iranian payments: all catalog prices are integer toman (IRT).
APP_URL=http://localhost:3000
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
