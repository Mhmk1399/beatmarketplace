{
  "name": "beatmarketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:indexes": "tsx scripts/ensure-indexes.ts",
    "db:search": "tsx scripts/search-index.ts",
    "db:slugs": "tsx scripts/track-slugs.ts",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/lib-storage": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.4",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "swr": "^2.5.1",
    "three": "^0.187.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.1",
    "@types/busboy": "^1.5.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
