{
  "name": "beatmarketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:indexes": "tsx scripts/ensure-indexes.ts",
    "db:search": "tsx scripts/search-index.ts",
    "db:slugs": "tsx scripts/track-slugs.ts",
    "db:previews": "tsx scripts/upgrade-previews.ts",
    "audio:demos": "tsx scripts/optimize-demo-audio.ts",
    "audio:verify": "tsx scripts/check-audio-delivery.ts",
    "test:audio-checks": "tsx --test tests/audio-checks.test.ts",
    "test:uploads": "tsx --test tests/upload-progress.test.ts",
    "test:media": "tsx --test tests/media-security.test.ts",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck",
    "test:security": "tsx --test tests/api-security.test.ts",
    "test:licensing": "tsx --test tests/licensing.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/lib-storage": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.3",
    "next": "^16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.1",
    "@types/busboy": "^1.5.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
